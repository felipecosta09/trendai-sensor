# Copy to .env for local docker runs. In Kubernetes the same variables are
# set via deploy/configmap.yaml; the two must stay in sync.

# NDR appliance IP. Must be reachable from the sensor host.
SENSOR=10.0.0.1

# VXLAN VNI in hex (0..ffffff).
VNI=0

# Link MTU between sensor host and NDR. Inner (captured) frame max is
# NDR_MTU - 50 (VXLAN + outer IP/UDP/Ethernet overhead).
NDR_MTU=1500

# Capture backend: auto picks tcbpf on kernels ≥ 5.8, afpacket elsewhere.
# Override to tcbpf or afpacket to force a specific path.
CAPTURE_MODE=auto

# Log level: debug, info, warn, error.
LOG_LEVEL=info

# HTTP listener addresses. Prometheus scrape: $METRICS_ADDR/metrics.
# Kubelet probes: $HEALTH_ADDR/{healthz,readyz}.
METRICS_ADDR=:9090
HEALTH_ADDR=:8080
